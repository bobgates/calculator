#![no_std]

// use core::assert;
use core::cmp::Ord;
use core::f64;
use core::option::Option;

use heapless::String;
use heapless::format;
// use heapless::{String, format};

use libm::{ceil, fabs, floor, fmod, log10, pow, round};

pub const EDIT_LENGTH: usize = 22;

/// Trait providing method for formatting numbers in [engineering
/// notation](https://en.wikipedia.org/wiki/Engineering_notation)
pub trait FormatEng {
    /// Method for converting numeric value into formatted string with [engineering
    /// notation](https://en.wikipedia.org/wiki/Engineering_notation)
    fn format_eng(&self, sf: Option<usize>) -> String<EDIT_LENGTH>;
}

impl FormatEng for f64 {
    /// Returns f64 as string in [engineering
    /// notation](https://en.wikipedia.org/wiki/Engineering_notation) with last digit rounded to nearest
    /// rather than truncated.
    ///
    /// # Arguments
    /// - `sf` - Number of significant figures, defaults to 3
    ///
    fn format_eng(&self, sf: Option<usize>) -> String<EDIT_LENGTH> {
        format_eng(*self, sf)
    }
}

/// Returns f64 as string in [engineering
/// notation](https://en.wikipedia.org/wiki/Engineering_notation) with last digit rounded to nearest
/// rather than truncated.
/// # Arguments
/// - `x` - value to be formatted
/// - `sf` - number of significant figures, defaults to 3
pub fn format_eng(x: f64, sf: Option<usize>) -> String<EDIT_LENGTH>  {
    let sf = sf.unwrap_or(3);
    // assert!(sf >= 1, "`format_eng` arg `sf` must be at least 1.");

    if x == 0. {
        return format!("{x:.*}", sf - 1).unwrap();
    }

    let abs_log10 = log10( x.abs());
    let exp_sci: i32 = if abs_log10 >= 0. {
        floor(abs_log10) as i32
    } else {
        ceil(abs_log10) as i32
    } as i32;

    // engineering notation exponent
    let exp_eng: i32 = if abs_log10 >= 0. {
        exp_sci - floor(abs_log10) as i32 % 3
    } else if fmod(abs_log10, 1.0) == 0. && fabs(abs_log10) as u32 % 3 == 0 {
        exp_sci - ceil(abs_log10) as i32 % 3
    } else {
        exp_sci - ceil(abs_log10) as i32 % 3 - 3
    };

    let mut x_base = match exp_eng {
        _ if exp_eng.abs() <= 2 => x,
        _ => x / pow(10_f64, exp_eng as f64),
    };

    // number of digits left of decimal _after_ formatting for engineering notation, should never
    // exceed 3
    let n_left_of_dec: i32 = if abs_log10 > 0. {
        floor(abs_log10) as i32 % 3 + 1
    } else if abs_log10 == 0. {
        1
    } else if fmod(abs_log10, 1.0)== 0. {  // substituted for abs_log10.fract()
        3 - (-(abs_log10 as i32 + 1) % 3)
    } else {
        3 - (-ceil(abs_log10) as i32 % 3)
    };

    // assert!(
    //     n_left_of_dec <= 3,
    //     "n_left_of_dec: {} exceeds 3",
    //     n_left_of_dec
    // );

    let n_dec = sf as i32 - n_left_of_dec;

    // round `x_base` as appropriate
    let exp = sf as i32 - n_left_of_dec;
    // x_base = (x_base * 10_f64.powi(exp)).round() * 10_f64.powi(-exp);
    x_base = round(x_base * pow(10_f64, exp as f64)) * pow(10_f64, -exp as f64);

    match exp_eng {
        _ if (0..=2).contains(&exp_eng) => format!("{x_base:.*}", n_dec.max(0) as usize).unwrap(),
        _ => format!("{x_base:.*}e{}", n_dec.max(0) as usize, exp_eng).unwrap(),
    }
}

#[allow(unused_macros)]
/// Generates a String similar to output of `dbg` but without printing.  
/// <https://doc.rust-lang.org/src/std/macros.rs.html#340-362>
macro_rules! format_dbg {
    () => {
        format!("[{}:{}]", file!(), line!())
    };
    ($val:expr $(,)?) => {
        format!("[{}:{}] {} = {:#?}",
            file!(),
            line!(),
            stringify!($val),
            $val
        )
    };
    ($($val:expr),+ $(,)?) => {
        ($(format_dbg!($val)),+,)
    };
}